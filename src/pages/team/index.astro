---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const team = await getCollection('team');
const sortedTeam = team.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const pageTitle = "Our Team - ExoGenic";
---

<BaseLayout title={pageTitle}>
    <section class="section-padding">
        <div class="container">
            <div style="text-align: center; margin-bottom: 60px;">
                <h1>Meet the <span class="animate-gradient-text">Team</span></h1>
                <p style="color: var(--text-muted); max-width: 600px; margin: 0 auto;">
                    The minds behind the machines. Engineers, researchers, and visionaries.
                </p>
            </div>

            {/* Directors Section */}
            <h2 class="section-title" style="margin-top: 0; margin-bottom: 30px;">Directors</h2>
            <div class="grid-3" style="justify-content: center; margin-bottom: 60px;">
                {sortedTeam.filter(m => m.data.category === 'Directors').map(member => (
                    <div class="card team-card glass clickable" onclick={`window.location.href='/team/${member.slug}'`}>
                        <div class="team-img">
                            {member.data.image ? 
                                <img src={member.data.image} alt={member.data.name} style="width:100%; height:100%; object-fit:cover; border-radius:50%;" /> 
                                : <i class="fa-solid fa-user"></i>}
                        </div>
                        <h3>{member.data.name}</h3>
                        <span class="role">{member.data.role}</span>
                    </div>
                ))}
            </div>

            {/* Advisors Section */}
            <h2 class="section-title" style="margin-bottom: 30px;">Advisors</h2>
            <div class="grid-3" style="margin-bottom: 60px;">
                {sortedTeam.filter(m => m.data.category === 'Advisors').map(member => (
                    <div class="card team-card glass clickable" onclick={`window.location.href='/team/${member.slug}'`}>
                        <div class="team-img">
                            {member.data.image ? 
                                <img src={member.data.image} alt={member.data.name} style="width:100%; height:100%; object-fit:cover; border-radius:50%;" /> 
                                : <i class="fa-solid fa-user"></i>}
                        </div>
                        <h3>{member.data.name}</h3>
                        <span class="role">{member.data.role}</span>
                    </div>
                ))}
            </div>

            {/* Core Team Section */}
            <h2 class="section-title" style="margin-bottom: 30px;">Core Team</h2>
            <div class="grid-3">
                {sortedTeam.filter(m => m.data.category === 'Core Team').map(member => (
                    <div class="card team-card glass clickable" onclick={`window.location.href='/team/${member.slug}'`}>
                        <div class="team-img">
                            {member.data.image ? 
                                <img src={member.data.image} alt={member.data.name} style="width:100%; height:100%; object-fit:cover; border-radius:50%;" /> 
                                : <i class="fa-solid fa-user"></i>}
                        </div>
                        <h3>{member.data.name}</h3>
                        <span class="role">{member.data.role}</span>
                    </div>
                ))}
            </div>
        </div>
    </section>
</BaseLayout>
